# ---------- Supabase (server only, never prefix with NEXT_PUBLIC_) ----------
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_OR_SECRET_KEY

# ---------- Session signing (server only) ----------
# Generate with:  openssl rand -base64 48
SESSION_SECRET=

# ---------- Sign in with Discord (free) ----------
# discord.com/developers/applications > New Application > OAuth2
# Redirect:  https://YOUR-DOMAIN/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
